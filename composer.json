{
  "name": "wexample/php-remote",
  "description": "Registry, health checks and php-api client building for the external services a PHP app talks to",
  "type": "library",
  "license": "MIT",
  "version": "1.0.3",
  "autoload": {
    "psr-4": {
      "Wexample\\PhpRemote\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\PhpRemote\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "guzzlehttp/guzzle": "^7.8",
    "wexample/php-api": ">=5.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ]
}